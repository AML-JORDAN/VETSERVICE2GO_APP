<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet: la base de datos está en Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No se piden permisos de fotos: el selector de fotos de Android no los necesita -->

    <!-- VetServiceApp se conecta con Firebase al abrir la app -->
    <application
        android:name=".VetServiceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VETSERVICE2GO">
        <activity
            android:name=".MisCitasActivity"
            android:exported="false" />

        <!-- Actividad principal / Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.VETSERVICE2GO.FondoClaro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Demás actividades de la aplicación -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".RegisterActivity" android:exported="false" android:theme="@style/Theme.VETSERVICE2GO.FondoClaro" />
        <!-- Pantalla del empleado: citas de todos los clientes -->
        <activity android:name=".EmpleadoActivity" android:exported="false" />
        <activity android:name=".RegisterPetActivity" android:exported="false" android:theme="@style/Theme.VETSERVICE2GO.FondoClaro" />
        <activity android:name=".ResumenActivity" android:exported="false" android:theme="@style/Theme.VETSERVICE2GO.FondoClaro" />
        <activity android:name=".FechaHoraActivity" android:exported="false" android:theme="@style/Theme.VETSERVICE2GO.FondoClaro" />
        <activity android:name=".PerfilActivity" android:exported="false" />

    </application>

</manifest>