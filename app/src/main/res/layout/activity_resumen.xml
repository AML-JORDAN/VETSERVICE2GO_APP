<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="Resumen de tu cita"
        android:textColor="#5E176F"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Tarjeta de Resumen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_marginBottom="24dp">

        <!-- Foto de la mascota (se ve solo si se subió una; lo decide ResumenActivity) -->
        <ImageView
            android:id="@+id/ivMascotaResumen"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#F3F1EA"
            android:contentDescription="Foto de la mascota"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvPropietarioResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Propietario:"
            android:textSize="16sp"
            android:textColor="#1A103C"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvMascotaResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mascota:"
            android:textSize="16sp"
            android:textColor="#1A103C"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvFechaResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha de la cita:"
            android:textSize="16sp"
            android:textColor="#1A103C"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvServiciosResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Servicios:"
            android:textSize="16sp"
            android:textColor="#1A103C"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvTotalResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total a pagar: $0 MXN"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5E176F"/>

    </LinearLayout>

    <!-- Botón para finalizar -->
    <Button
        android:id="@+id/btnFinalizar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="FINALIZAR Y VOLVER AL INICIO"
        android:textStyle="bold"
        android:backgroundTint="#75C9C8"
        android:textColor="#1A103C"/>

</LinearLayout>