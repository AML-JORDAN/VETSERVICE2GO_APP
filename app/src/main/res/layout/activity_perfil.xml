<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Cabecera Superior -->
    <LinearLayout
        android:id="@+id/headerPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#5E176F"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VETSERVICE2GO.COM"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mi Perfil"
            android:textColor="#F3E5F5"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Datos de la cuenta (los llena PerfilActivity) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerPerfil"
        app:layout_constraintBottom_toTopOf="@id/bottomNavPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Logo de VETSERVICE2GO"
                    android:src="@drawable/logo_vet" />

                <TextView
                    android:id="@+id/tvCorreoPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="correo@ejemplo.com"
                    android:textColor="#1A103C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRolPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="👤 Cuenta de cliente"
                    android:textColor="#5E176F"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/lavender" />

                <TextView
                    android:id="@+id/tvCitasPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Citas guardadas en la app: 0"
                    android:textColor="#1A103C"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnPerfilMisCitas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#80A1D4"
            android:text="VER MIS CITAS"
            android:textColor="#1A103C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/periwinkle"
            android:text="CERRAR SESIÓN"
            android:textColor="#1A103C"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra Inferior de Navegación: cada opción es un texto con su ícono arriba -->
    <LinearLayout
        android:id="@+id/bottomNavPerfil"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Inicio"
            android:textColor="#3A3A3A"
            android:textSize="12sp"
            app:drawableTint="#3A3A3A"
            app:drawableTopCompat="@drawable/ic_nav_inicio" />

        <TextView
            android:id="@+id/navMisCitas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Mis Citas"
            android:textColor="#3A3A3A"
            android:textSize="12sp"
            app:drawableTint="#3A3A3A"
            app:drawableTopCompat="@drawable/ic_nav_citas" />

        <TextView
            android:id="@+id/navRegistrar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Registrar"
            android:textColor="#3A3A3A"
            android:textSize="12sp"
            app:drawableTint="#3A3A3A"
            app:drawableTopCompat="@drawable/ic_nav_registrar" />

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Perfil"
            android:textColor="#26A69A"
            android:textSize="12sp"
            android:textStyle="bold"
            app:drawableTint="#26A69A"
            app:drawableTopCompat="@drawable/ic_nav_perfil" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
