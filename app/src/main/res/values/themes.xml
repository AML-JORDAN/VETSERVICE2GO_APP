<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.VETSERVICE2GO" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Color de fondo de todas las pantallas (Floral White, como en la página web) -->
        <item name="android:windowBackground">@color/floral_white</item>
    </style>

    <!-- Para las pantallas que arriba son de color claro (sin cabecera morada o azul):
         la hora y los íconos de la barra de estado se ven en oscuro -->
    <style name="Theme.VETSERVICE2GO.FondoClaro">
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>